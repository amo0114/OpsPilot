{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opspilot.local/contracts/ai-runtime/v1/remediation-draft-request.schema.json",
  "title": "RemediationDraftRequest",
  "description": "Java -> AI Runtime: POST /internal/v1/remediation/draft (05 §87). Only for PRIMARY/POSSIBLE diagnoses; the AI may choose only from allowedActions. No RecoveryPolicy, container identity or credential is sent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "correlationId",
    "incident",
    "diagnosis",
    "allowedActions"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incidentKey",
        "impactSummary"
      ],
      "properties": {
        "incidentKey": {
          "type": "string",
          "pattern": "^INC-[0-9]{8}-[0-9]{4,}$"
        },
        "impactSummary": {
          "$ref": "#/$defs/text1000"
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "conclusionType",
        "summary",
        "evidence"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "conclusionType": {
          "enum": [
            "PRIMARY_CAUSE_IDENTIFIED",
            "POSSIBLE_CAUSE"
          ]
        },
        "summary": {
          "$ref": "#/$defs/text2000"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "summary"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "summary": {
                "$ref": "#/$defs/text1000"
              }
            }
          }
        }
      }
    },
    "allowedActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityKey",
          "resourceId",
          "resourceKey",
          "resourceName"
        ],
        "properties": {
          "capabilityKey": {
            "const": "service.restart"
          },
          "resourceId": {
            "$ref": "#/$defs/id"
          },
          "resourceKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "resourceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "text1000": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]"
    },
    "text2000": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]"
    }
  }
}
